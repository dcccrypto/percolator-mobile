# Percolator API (Hono — markets, funding, OI, insurance, trades, stats)
# Railway direct URL (api.percolatorlaunch.com DNS not configured yet)
EXPO_PUBLIC_API_URL=https://percolator-api-production.up.railway.app

# Percolator Web API (Next.js — leaderboard, trader stats, stake pools)
EXPO_PUBLIC_WEB_URL=https://percolatorlaunch.com/api

# Helius API key — REQUIRED. Set via EAS Secrets in CI. Copy to .env.local for dev.
# Never commit a real key here. Generate one at https://dev.helius.xyz
EXPO_PUBLIC_HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE

# Solana RPC — REQUIRED. Set via EAS Secrets in CI. Copy to .env.local for dev.
# Recommended: use Helius devnet/mainnet RPC endpoint with your API key.
# e.g. https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE
EXPO_PUBLIC_CLUSTER=devnet
EXPO_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE

# WebSocket — optional override. If not set, EXPO_PUBLIC_HELIUS_API_KEY is used.
# EXPO_PUBLIC_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE

# Supabase (shared with web app)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Pyth Push Oracle shard_id (little-endian u16, defaults to 0).
# Only change this if Pyth deploys a shard other than 0 for your cluster.
# EXPO_PUBLIC_PYTH_SHARD_ID=0
